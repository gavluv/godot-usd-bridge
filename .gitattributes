# Line endings are a property of the repository, not of each clone's
# core.autocrlf setting: text files are LF in the index and in the working
# tree. MSVC, clang-format, Godot and Windows PowerShell 5.1 all read LF.
* text=auto eol=lf

# cmd.exe needs CRLF. None are tracked today.
*.bat text eol=crlf
*.cmd text eol=crlf
