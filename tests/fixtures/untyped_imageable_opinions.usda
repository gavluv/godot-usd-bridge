#usda 1.0
(
    doc = """Imageable fixture (task 1.6): visibility and purpose authored on
    an untyped prim, which USD ignores.

    visibility and purpose belong to the UsdGeomImageable schema. An untyped
    `def` is not Imageable, so attributes with those names on it carry no
    meaning: UsdGeomImageable::ComputeVisibility and ComputePurposeInfo step
    over it, and its child is visible and default.

    The trap is that UsdGeomImageable(prim).GetVisibilityAttr() reads the
    attribute by name whatever the prim's type, so on Untyped it returns
    "invisible" (as of OpenUSD v26.05). The importer has to check that the
    prim is Imageable before reading.

    The Mesh is the quad_mesh.usda quad.

    EXPECTED -- to_imageable_data, per prim
      /Root/Untyped         visible = true   purpose default
      /Root/Untyped/Child   visible = true   purpose default
      no warnings on any prim

    DETECTOR: an importer that reads visibility through the schema object
    without checking that it is valid flags Untyped, and Godot then hides
    Child. The purpose half guards a different change: ComputePurposeInfo
    checks validity itself, but replacing it with a by-name read of purpose
    would make Child guide and hide it."""
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def "Untyped"
    {
        uniform token purpose = "guide"
        token visibility = "invisible"

        def Mesh "Child"
        {
            float3[] extent = [(-1, 0, -1), (1, 0, 1)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            point3f[] points = [(-1, 0, -1), (-1, 0, 1), (1, 0, 1), (1, 0, -1)]
        }
    }
}
